{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "co-pilot-ai-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // This Worker IS co-pilot.ai. Deploying attaches both hostnames to it.
  "routes": [
    { "pattern": "co-pilot.ai", "custom_domain": true },
    { "pattern": "www.co-pilot.ai", "custom_domain": true }
  ],
  "assets": {
    // The public site. Anything outside ./public (docs, the Worker source) is never served.
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Let the Worker see every request first (www → apex redirect, /book links, /api).
    "run_worker_first": true
  },
  "vars": {
    // Where every sign-up is sent. SecondBrain syncs this inbox.
    "LEAD_NOTIFY_TO": "shawn@energiacres.com",
    "LEAD_FROM": "Co-Pilot <copilot@updates.shawncutter.com>"
  }
  // Secrets (set with `npx wrangler secret put NAME`, never committed):
  //   RESEND_API_KEY              sends each sign-up to LEAD_NOTIFY_TO
  //   SECONDBRAIN_WEBHOOK_URL     optional: SecondBrain's visitor-message endpoint, when live
  //   SECONDBRAIN_WEBHOOK_SECRET  optional: signs that webhook (HMAC-SHA256)
  // Optional backup copy of every sign-up, after `npx wrangler kv namespace create LEADS`:
  //   "kv_namespaces": [{ "binding": "LEADS", "id": "<id from that command>" }]
}
